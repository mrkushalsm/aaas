{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AaaS benchmark observation v1",
  "type": "object",
  "required": ["schema_version", "runtime", "revision", "host_id", "workload", "state", "status", "sample_count"],
  "properties": {
    "schema_version": {"const": 1},
    "runtime": {"enum": ["waydroid", "droidloom", "aas-minimal", "aas-lipstick"]},
    "revision": {"type": "string", "minLength": 1},
    "host_id": {"type": "string", "minLength": 1},
    "workload": {"type": "string", "minLength": 1},
    "state": {"enum": ["cold", "warm", "frozen", "idle", "animation"]},
    "status": {"enum": ["measured", "unavailable", "unsupported", "failed"]},
    "reason": {"type": "string"},
    "sample_count": {"type": "integer", "minimum": 0},
    "launch_first_present_ms": {"type": "number", "minimum": 0},
    "frame_interval_p50_ms": {"type": "number", "minimum": 0},
    "frame_interval_p95_ms": {"type": "number", "minimum": 0},
    "frame_interval_p99_ms": {"type": "number", "minimum": 0},
    "frame_interval_p999_ms": {"type": "number", "minimum": 0},
    "cpu_time_ms": {"type": "number", "minimum": 0},
    "memory_pss_mib": {"type": "number", "minimum": 0},
    "direct_imports": {"type": "integer", "minimum": 0},
    "gpu_blits": {"type": "integer", "minimum": 0},
    "cpu_copies": {"type": "integer", "minimum": 0},
    "acquire_fence_count": {"type": "integer", "minimum": 0},
    "release_fence_count": {"type": "integer", "minimum": 0},
    "sync_errors": {"type": "integer", "minimum": 0}
  },
  "allOf": [{"if": {"properties": {"status": {"const": "measured"}}}, "then": {"properties": {"sample_count": {"minimum": 1}}, "required": ["launch_first_present_ms", "cpu_time_ms", "memory_pss_mib", "direct_imports", "gpu_blits", "cpu_copies", "acquire_fence_count", "release_fence_count", "sync_errors"]}}, {"if": {"properties": {"status": {"enum": ["unavailable", "unsupported", "failed"]}}}, "then": {"required": ["reason"]}}],
  "additionalProperties": false
}
