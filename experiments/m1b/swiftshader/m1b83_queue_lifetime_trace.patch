+#include <cstdarg>
+#include <cstdio>
+#include <cstring>
+#include <dlfcn.h>
+#include <unistd.h>
+#include <time.h>
+
+static void m1b82TraceLifetime(const char *format, ...)
+{
+	char message[256];
+	va_list args;
+	va_start(args, format);
+	std::vsnprintf(message, sizeof(message), format, args);
+	va_end(args);
+	using LogWrite = int (*)(int, const char *, const char *);
+	static LogWrite logWrite = [] {
+		void *liblog = dlopen("liblog.so", RTLD_NOW | RTLD_LOCAL);
+		return liblog ? reinterpret_cast<LogWrite>(dlsym(liblog, "__android_log_write")) : nullptr;
+	}();
+	if(logWrite)
+	{
+		logWrite(3, "M1B83-LIFETIME", message);
+	}
+	else
+	{
+		std::fprintf(stderr, "[M1B83-LIFETIME] %s\n", message);
+	}
+}
