on post-fs-data
    # Development runtime uses a rootless data bind mount. Android's per-app
    # /data_mirror bind mounts are unavailable there and abort zygote forks.
    # Keep this scoped to the explicitly non-production AaaS runtime.
    setprop persist.zygote.app_data_isolation false

service aaas-display-broker /system/bin/app_process64 /system/bin --nice-name=aaas-display-broker com.aaas.display.AaasDisplayBroker 720 1280 240 /dev/aaas/vdisplay_id /dev/aaas/display_broker.log /dev/aaas/display_broker_shutdown /dev/aaas/vdisplay2_id AAAS_DISPLAY_COUNT
    class late_start
    user system
    group system graphics
    disabled
    oneshot
    setenv CLASSPATH /system/framework/aaas-display-broker.dex
    setenv LD_PRELOAD /system/lib64/libselinux_shim.so
