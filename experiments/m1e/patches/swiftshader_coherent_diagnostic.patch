new file mode 100644
index 0000000..d56c92b
--- /dev/null
+++ b/src/Vulkan/AaasDiagnosticTrace.hpp
@@ -0,0 +1,120 @@
+#ifndef AAAS_VULKAN_DIAGNOSTIC_TRACE_HPP_
+#define AAAS_VULKAN_DIAGNOSTIC_TRACE_HPP_
+
+#if defined(AAAS_SWIFTSHADER_JIT_TRACE) && !defined(_WIN32)
+#include <algorithm>
+#include <atomic>
+#include <cstdarg>
+#include <cstdio>
+#include <mutex>
+#include <string>
+#include <unordered_map>
+#include <sys/syscall.h>
+#include <time.h>
+#include <unistd.h>
+#include <fcntl.h>
+
+namespace vk {
+
+struct AaasDiagnosticRegistry
+{
+	std::mutex mutex;
+	std::unordered_map<const void *, uint64_t> ids;
+	uint64_t nextId = 0;
+};
+
+inline AaasDiagnosticRegistry &AaasDiagnosticObjects()
+{
+	static AaasDiagnosticRegistry registry;
+	return registry;
+}
+
+inline uint64_t AaasDiagnosticObjectId(const void *object)
+{
+	if(!object) return 0;
+	auto &registry = AaasDiagnosticObjects();
+	std::lock_guard<std::mutex> lock(registry.mutex);
+	auto it = registry.ids.find(object);
+	if(it != registry.ids.end()) return it->second;
+	if(registry.ids.size() >= 16384) return 0;
+	const uint64_t id = ++registry.nextId;
+	registry.ids.emplace(object, id);
+	return id;
+}
+
+inline uint64_t AaasDiagnosticObjectCreate(const void *object)
+{
+	if(!object) return 0;
+	auto &registry = AaasDiagnosticObjects();
+	std::lock_guard<std::mutex> lock(registry.mutex);
+	const uint64_t id = ++registry.nextId;
+	if(registry.ids.size() < 16384) registry.ids[object] = id;
+	return id;
+}
+
+inline void AaasDiagnosticObjectRetire(const void *object)
+{
+	if(!object) return;
+	auto &registry = AaasDiagnosticObjects();
+	std::lock_guard<std::mutex> lock(registry.mutex);
+	registry.ids.erase(object);
+}
+
+inline void AaasDiagnosticTrace(const char *format, ...)
+{
+	static std::atomic<uint32_t> budget{ 0 };
+	if(budget.fetch_add(1, std::memory_order_relaxed) >= 32768) return;
+	char path[96];
+	snprintf(path, sizeof(path), "/dev/aaas/swiftshader-jit-%d.log", getpid());
+	char line[1024];
+	timespec now{};
+	clock_gettime(CLOCK_MONOTONIC, &now);
+	int prefix = snprintf(line, sizeof(line), "mono_ns=%lld pid=%d tid=%ld ",
+	                      static_cast<long long>(now.tv_sec) * 1000000000LL + now.tv_nsec,
+	                      getpid(), static_cast<long>(syscall(SYS_gettid)));
+	if(prefix < 0 || static_cast<size_t>(prefix) >= sizeof(line)) return;
+	va_list args;
+	va_start(args, format);
+	int count = vsnprintf(line + prefix, sizeof(line) - static_cast<size_t>(prefix) - 1, format, args);
+	va_end(args);
+	if(count < 0) return;
+	size_t length = static_cast<size_t>(prefix) +
+	                std::min(static_cast<size_t>(count), sizeof(line) - static_cast<size_t>(prefix) - 2);
+	line[length++] = '\n';
+	int fd = open(path, O_WRONLY | O_CREAT | O_APPEND | O_CLOEXEC, 0600);
+	if(fd < 0) return;
+	(void)write(fd, line, length);
+	close(fd);
+}
+
+struct AaasDiagnosticDrawContext
+{
+	uint64_t submissionId = 0;
+	uint64_t drawId = 0;
+};
+
+inline AaasDiagnosticDrawContext &AaasDiagnosticCurrentDraw()
+{
+	static thread_local AaasDiagnosticDrawContext context;
+	return context;
+}
+
+inline void AaasDiagnosticSetDrawContext(uint64_t submissionId, uint64_t drawId)
+{
+	AaasDiagnosticCurrentDraw() = { submissionId, drawId };
+}
+
+}  // namespace vk
+#else
+namespace vk {
+inline uint64_t AaasDiagnosticObjectId(const void *) { return 0; }
+inline void AaasDiagnosticObjectRetire(const void *) {}
+inline uint64_t AaasDiagnosticObjectCreate(const void *) { return 0; }
+inline void AaasDiagnosticTrace(const char *, ...) {}
+struct AaasDiagnosticDrawContext { uint64_t submissionId = 0; uint64_t drawId = 0; };
+inline AaasDiagnosticDrawContext &AaasDiagnosticCurrentDraw() { static AaasDiagnosticDrawContext context; return context; }
+inline void AaasDiagnosticSetDrawContext(uint64_t, uint64_t) {}
+}  // namespace vk
+#endif
+
+#endif  // AAAS_VULKAN_DIAGNOSTIC_TRACE_HPP_
