 // Subzero utility functions
 // These functions only accept and return Subzero (Ice) types, and do not access any globals.
 namespace {
+#if defined(AAAS_SWIFTSHADER_JIT_TRACE) && !defined(_WIN32)
+void aaasJitTrace(const char *format, ...)
+{
+	char path[96];
+	snprintf(path, sizeof(path), "/dev/aaas/swiftshader-jit-%d.log", getpid());
+	char line[1024];
+	timespec now{};
+	clock_gettime(CLOCK_MONOTONIC, &now);
+	int prefix = snprintf(line, sizeof(line), "mono_ns=%lld pid=%d tid=%ld ",
+	                      static_cast<long long>(now.tv_sec) * 1000000000LL + now.tv_nsec,
+	                      getpid(), static_cast<long>(syscall(SYS_gettid)));
+	if(prefix < 0 || static_cast<size_t>(prefix) >= sizeof(line)) return;
+	va_list args;
+	va_start(args, format);
+	int count = vsnprintf(line + prefix, sizeof(line) - static_cast<size_t>(prefix) - 1, format, args);
+	va_end(args);
+	if(count < 0) return;
+	size_t length = static_cast<size_t>(prefix) +
+	                std::min(static_cast<size_t>(count), sizeof(line) - static_cast<size_t>(prefix) - 2);
+	line[length++] = '\n';
+	int fd = open(path, O_WRONLY | O_CREAT | O_APPEND | O_CLOEXEC, 0644);
+	if(fd < 0) return;
+	(void)write(fd, line, length);
+	close(fd);
+}
+
+void aaasJitCodeTrace(uint64_t id, const char *name, const void *address, size_t bytes)
+{
+	if(strncmp(name, "PixelRoutine_", 13) != 0 || bytes == 0 || bytes > 65536) return;
+	struct RecordHeader
+	{
+		uint32_t magic = 0x414a4954;  // "TIJA" in little endian
+		uint32_t version = 1;
+		uint64_t id;
+		uint64_t address;
+		uint64_t bytes;
+		uint32_t nameBytes;
+	};
+	static std::mutex mutex;
+	static size_t capturedBytes = 0;
+	std::lock_guard<std::mutex> lock(mutex);
+	if(capturedBytes + bytes > 2 * 1024 * 1024) return;
+	capturedBytes += bytes;
+	char path[96];
+	snprintf(path, sizeof(path), "/dev/aaas/swiftshader-jit-%d.code", getpid());
+	int fd = open(path, O_WRONLY | O_CREAT | O_APPEND | O_CLOEXEC, 0600);
+	if(fd < 0) return;
+	RecordHeader header{};
+	header.id = id;
+	header.address = reinterpret_cast<uintptr_t>(address);
+	header.bytes = bytes;
+	header.nameBytes = static_cast<uint32_t>(strlen(name));
+	auto writeAll = [fd](const void *data, size_t length) {
+		const auto *cursor = static_cast<const uint8_t *>(data);
+		while(length > 0)
+		{
+			ssize_t written = write(fd, cursor, length);
+			if(written <= 0) return false;
+			cursor += written;
+			length -= static_cast<size_t>(written);
+		}
+		return true;
+	};
+	(void)(writeAll(&header, sizeof(header)) &&
+	       writeAll(name, header.nameBytes) &&
+	       writeAll(address, bytes));
+	close(fd);
+}
